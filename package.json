{
  "name": "symark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test \"tests/unit/*.test.ts\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "node --experimental-strip-types --test --watch \"tests/unit/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test \"tests/unit/*.test.ts\"",
    "check": "node scripts/check-code-size.js && node scripts/check-bundle-size.js && tsc --noEmit && npm test && npm run test:rust && npm run build",
    "check:full": "npm run check && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "font:subset": "node scripts/subset-font.mjs",
    "font:fetch": "node scripts/fetch-font.mjs && npm run font:subset"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "docx": "9.7.1",
    "dompurify": "^3.4.13",
    "html-to-docx": "1.8.0",
    "katex": "0.16.47",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "subset-font": "^2.5.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.16"
  }
}
